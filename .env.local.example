# Jettison environment template.
#
# Local development runs against the local Supabase stack (`supabase start`,
# Docker). Put local values in .env.development.local, which `pnpm dev` reads
# before .env.local:
#
#   supabase status -o env
#   -> API_URL          => NEXT_PUBLIC_SUPABASE_URL
#   -> PUBLISHABLE_KEY  => NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   -> SECRET_KEY       => SUPABASE_SECRET_KEY
#
# Hosted environments (UAT on Vercel) set the same names in the Vercel
# dashboard, with values from the hosted project (Project Settings -> API
# Keys). Never commit real values; .env* files are gitignored.
#
# Naming follows Supabase's API-key system:
#   - sb_publishable_*  (public, safe in browser)  -> replaces "anon key"
#   - sb_secret_*       (server-only, RLS-bypass)  -> replaces "service_role key"

# --- Public (browser-visible) ---------------------------------------------
# Inlined into the client bundle by Next.js. Do NOT put anything secret
# behind a NEXT_PUBLIC_* name -- the prefix means "ship to every visitor".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry DSN. Public by design (it only allows sending events). Leave empty
# locally to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Tags Sentry events: local | uat | production
NEXT_PUBLIC_APP_ENV=local

# --- Server-only ----------------------------------------------------------
# Never prefix with NEXT_PUBLIC_, never import from a "use client" module.
# `pnpm check:secrets` enforces the boundary.

# Canonical origin for emailed links (e.g. https://uat.example.com). Defaults
# to http://localhost:3000 in development; required in production.
SITE_URL=http://localhost:3000

# Secret key: bypasses RLS. Used only by lib/supabase/admin.ts (image
# pipeline). Required wherever images are uploaded or moderated.
SUPABASE_SECRET_KEY=

# Set to true on production at launch to let search engines index the site.
# ALLOW_INDEXING=true

# Sentry source-map upload at build time (Vercel only).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
